      <remove statusCode="404"/>
      <remove statusCode="500"/>
      <remove statusCode="503"/>
      <error statusCode="404" path="404.aspx" responseMode="Redirect"/>
      <error statusCode="500" path="errorpage.aspx" responseMode="Redirect"/>
      <error statusCode="503" path="errorpage.aspx" responseMode="Redirect"/>
    </httpErrors>-->
    <rewrite>
      <rules>
        <!-- Redirect root domain to a specific page -->
        <rule name="RootRedirect" stopProcessing="true">
          <match url="^$"/>
          <action type="Rewrite" url="Home.aspx"/>
        </rule>
		
      </rules>
    </rewrite>
  </system.webServer>
</configuration>