<form action="#" id="contact-form" name="contact-form">

    <div class="alert hidden" id="contact-form-msg"></div>

    <!-- First Name -->
    <div class="form-group">
        <asp:Label
            ID="lblCustName"
            runat="server"
            AssociatedControlID="txtCustName"
            Text="First Name"
            CssClass="form-label">
        </asp:Label>

        <asp:TextBox
            runat="server"
            ID="txtCustName"
            CssClass="form-control first-name text-field"
            placeholder="Enter First Name">
        </asp:TextBox>
    </div>


    <!-- Last Name -->
    <div class="form-group">
        <asp:Label
            ID="lblLastname"
            runat="server"
            AssociatedControlID="txtLastname"
            Text="Last Name"
            CssClass="form-label">
        </asp:Label>

        <asp:TextBox
            runat="server"
            ID="txtLastname"
            CssClass="form-control last-name text-field"
            placeholder="Enter Last Name">
        </asp:TextBox>

        <div class="clearfix"></div>
    </div>


    <!-- Mobile Number -->
    <div class="form-group">
        <asp:Label
            ID="lblCustMobileNo"
            runat="server"
            AssociatedControlID="txtCustMobileNo"
            Text="Mobile Number"
            CssClass="form-label">
        </asp:Label>

        <asp:TextBox
            runat="server"
            ID="txtCustMobileNo"
            MaxLength="10"
            CssClass="form-control telephone text-field"
            onkeypress="return isNumber(event)"
            placeholder="Enter Mobile Number">
        </asp:TextBox>
    </div>


    <!-- Email -->
    <div class="form-group">
        <asp:Label
            ID="lblCustEmail"
            runat="server"
            AssociatedControlID="txtCustEmail"
            Text="Email Address"
            CssClass="form-label">
        </asp:Label>

        <asp:TextBox
            runat="server"
            ID="txtCustEmail"
            TextMode="Email"
            CssClass="form-control email text-field"
            placeholder="Enter Email Address">
        </asp:TextBox>
    </div>


    <!-- Message -->
    <div class="form-group">
        <asp:Label
            ID="lblCustMesssage"
